            <h2 id="shelf-macro-heading" class="shelf-h2">Check what is on disk</h2>
            <p class="shelf-note">
                Paste this as a Foundry macro (script). It is not shipped inside any Ionrift module.
                It reads a status listing, compares local overlay manifests, and prints a diff to the browser console (F12).
            </p>
            <pre class="shelf-macro" id="shelf-macro-source"><code>/* Ionrift overlay status check
 * Paste as a Script macro. Open F12 console for output.
 * Not part of any Foundry module package.
 */
(async () => {
  const STATUS_URL = "https://api.ionrift.cloud/packs/status";
  const compare = (a, b) => {
    const pa = String(a || "0").split(".").map((n) => parseInt(n, 10) || 0);
    const pb = String(b || "0").split(".").map((n) => parseInt(n, 10) || 0);
    const len = Math.max(pa.length, pb.length);
    for (let i = 0; i < len; i++) {
      const d = (pa[i] || 0) - (pb[i] || 0);
      if (d) return d < 0 ? -1 : 1;
    }
    return 0;
  };

  let listing;
  try {
    const res = await fetch(STATUS_URL, { cache: "no-store" });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    listing = await res.json();
  } catch (err) {
    console.error("Ionrift status: failed to fetch listing", err);
    ui.notifications?.error?.("Ionrift status: could not reach the status listing.");
    return;
  }

  const overlays = listing.overlays || [];
  console.group("Ionrift overlay status");
  for (const row of overlays) {
    const path = row.installPath;
    if (!path) {
      console.log(`${row.id}: no install path in listing`);
      continue;
    }
    let local = null;
    try {
      const manifestPath = `${path}overlay-manifest.json`.replace(/\\/g, "/");
      const res = await fetch(manifestPath, { cache: "no-store" });
      if (!res.ok) throw new Error(String(res.status));
      const raw = await res.json();
      local = raw?.version || raw?.overlayVersion || null;
    } catch (_) {
      local = null;
    }

    if (!local) {
      console.log(`${row.id}: MISSING (latest ${row.latest}) → ${path}`);
    } else if (compare(local, row.latest) < 0) {
      console.log(`${row.id}: outdated (installed ${local}, latest ${row.latest})`);
    } else if (compare(local, row.latest) > 0) {
      console.log(`${row.id}: newer than listing (installed ${local}, listing ${row.latest})`);
    } else {
      console.log(`${row.id}: at latest (${local})`);
    }
  }
  console.log("Updates: https://ionrift.cloud/overlay-shelf/");
  console.groupEnd();
  ui.notifications?.info?.("Ionrift status written to the console (F12).");
})();</code></pre>
