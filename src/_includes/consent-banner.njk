<section id="consent-banner" class="consent-banner" role="region" aria-labelledby="consent-title" aria-describedby="consent-desc" tabindex="-1" hidden>
        <div class="consent-inner">
            <div class="consent-text">
                <h2 id="consent-title" class="consent-title">Can we count your visit?</h2>
                <p id="consent-desc" class="consent-desc">We'd like to use Google Analytics to see which pages get read and which links get clicked. It sets a few cookies, and it only switches on if you say yes. The site works the same either way. <a href="/privacy/">Privacy and cookies</a></p>
                <p class="consent-status" data-consent-status aria-live="polite"></p>
            </div>
            <div class="consent-actions">
                <button type="button" class="consent-btn" data-consent-accept>Accept analytics</button>
                <button type="button" class="consent-btn" data-consent-decline>Decline</button>
            </div>
        </div>
    </section>
