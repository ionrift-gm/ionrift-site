<script>
        // Analytics consent. GA4 is not requested until the visitor accepts.
        // Consent Mode v2 defaults are all denied; only analytics_storage is ever granted.
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
        });
        window.ionriftGaId = '{{ site.gaId }}';
        // Internal traffic flag: ?internal=1 sets it, ?internal=0 clears it. The param is
        // removed from the address before GA can read page_location. Other params (utm_*) stay.
        (function () {
            var flag = false;
            try {
                var url = new URL(location.href);
                var v = url.searchParams.get('internal');
                if (v === '1') localStorage.setItem('ionrift_internal', '1');
                if (v === '0') localStorage.removeItem('ionrift_internal');
                if (url.searchParams.has('internal')) {
                    url.searchParams.delete('internal');
                    history.replaceState(history.state, '', url.pathname + url.search + url.hash);
                }
                flag = localStorage.getItem('ionrift_internal') === '1';
            } catch (e) {}
            window.ionriftInternal = flag;
        })();
        (function () {
            var choice = null;
            try {
                var saved = JSON.parse(localStorage.getItem('ionrift_consent') || 'null');
                if (saved && saved.v === 1) choice = saved.analytics;
            } catch (e) {}
            window.ionriftConsent = choice === 'granted' || choice === 'denied' ? choice : 'unset';
            window.ionriftLoadGA = function () {
                if (window.ionriftGaLoaded) return;
                window.ionriftGaLoaded = true;
                gtag('consent', 'update', { analytics_storage: 'granted' });
                var s = document.createElement('script');
                s.async = true;
                s.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.ionriftGaId;
                document.head.appendChild(s);
                gtag('js', new Date());
                gtag('config', window.ionriftGaId, Object.assign({
                    allow_google_signals: false,
                    allow_ad_personalization_signals: false
                }, window.ionriftInternal ? { traffic_type: 'internal' } : {}));
            };
            if (window.ionriftConsent === 'granted') window.ionriftLoadGA();
        })();
    </script>
