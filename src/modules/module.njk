---
layout: landing.njk
pagination:
  data: collections.moduleDetails
  size: 1
  alias: module
  addAllPagesToCollections: true
permalink: "/modules/{{ module.id }}/"
eleventyComputed:
  title: "{{ module.seoTitle or (module.name ~ ': ' ~ module.tagline ~ ' for Foundry VTT | Ionrift Workshop') }}"
  description: "{{ module.seoDescription or module.description }}"
  canonical: "{{ site.url }}/modules/{{ module.id }}/"
  ogTitle: "{{ module.name }} for Foundry VTT"
  ogDescription: "{{ module.description }}"
  ogImage: "{{ site.url }}{{ module.preview or module.icon }}"
  bodyClass: "page-module-detail"
---

{% set hideShelfLinks = module.suppressShelfLinks %}
{% include "landing/nav.njk" %}

<main class="page-main module-detail" data-track-location="module_page" data-module-id="{{ module.id }}">
    <div class="container">
        <nav class="page-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span aria-hidden="true">/</span>
            <a href="/#modules">Modules</a>
            <span aria-hidden="true">/</span>
            <span>{{ module.name }}</span>
        </nav>

        <header class="module-detail-header" style="--module-color: {{ module.accent }}; --module-icon-color: {{ module.iconAccent or module.accent }};">
            <div class="module-detail-icon">
                <img src="{{ module.icon | webp }}" alt="" width="72" height="72">
            </div>
            <div class="module-detail-intro">
                <div class="module-detail-pills">
{% set pillClass = "pill-released" %}
{% set pillText = "Released" %}
{% if module.status == "ea" %}{% set pillClass = "pill-ea" %}{% set pillText = "Early Access" %}{% endif %}
{% if module.status == "ga" %}{% set pillText = "Released" %}{% endif %}
{% if module.status == "retired" %}{% set pillClass = "pill-retired" %}{% set pillText = "Retired" %}{% endif %}
                    <span class="module-pill {{ pillClass }}">{{ pillText }}</span>
{% if module.accessLabel %}
                    <span class="module-pill pill-premium">{{ module.accessLabel }}</span>
{% endif %}
                </div>
                <h1 class="module-detail-title">{{ module.name }}</h1>
                <p class="module-detail-tag" style="color: {{ module.accent }};">{{ module.tagline }}</p>
{% if module.systems and module.systems.length %}
                <div class="module-systems">
{% for s in module.systems %}
                    <span class="module-system">{{ s | systemLabel }}</span>
{% endfor %}
                </div>
{% endif %}
            </div>
        </header>

        <div class="module-trailer">
{% if module.gallery and module.gallery.length %}
            <section class="module-gallery" data-gallery aria-roledescription="carousel" aria-label="{{ module.name }} screenshots">
                <div class="module-trailer-preview-label">Screenshots</div>
                <div class="module-gallery-viewport">
                    <ul class="module-gallery-track" tabindex="0" aria-label="{{ module.name }} screenshots, scroll sideways for more">
{% for img in module.gallery %}
                        <li class="module-gallery-slide" role="group" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ module.gallery.length }}">
                            <figure class="module-gallery-figure">
                                <picture>
{% if (img.src | webp) != img.src %}
                                    <source type="image/webp" srcset="{{ img.src | webp }}">
{% endif %}
                                    <img src="{{ img.src }}" alt="{{ img.alt }}" width="{{ img.width }}" height="{{ img.height }}"{% if not loop.first %} loading="lazy"{% endif %} decoding="async">
                                </picture>
{% if img.caption %}
                                <figcaption class="module-gallery-caption">{{ img.caption }}</figcaption>
{% endif %}
                            </figure>
                        </li>
{% endfor %}
                    </ul>
                    <button type="button" class="module-gallery-btn module-gallery-btn--prev" data-gallery-prev aria-label="Previous screenshot" hidden>&#8249;</button>
                    <button type="button" class="module-gallery-btn module-gallery-btn--next" data-gallery-next aria-label="Next screenshot" hidden>&#8250;</button>
                </div>
                <div class="module-gallery-nav" data-gallery-nav hidden>
                    <div class="module-gallery-dots">
{% for img in module.gallery %}
                        <button type="button" class="module-gallery-dot" data-gallery-dot="{{ loop.index0 }}" aria-label="Show screenshot {{ loop.index }} of {{ module.gallery.length }}"></button>
{% endfor %}
                    </div>
                    <span class="module-gallery-counter" data-gallery-counter aria-live="polite">1 / {{ module.gallery.length }}</span>
                </div>
            </section>
            <script src="/js/module-gallery.js" defer></script>
{% elif module.trailer %}
            <div class="module-trailer-embed">
                <iframe
                    src="https://www.youtube-nocookie.com/embed/{{ module.trailer }}"
                    title="{{ module.name }} trailer"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                ></iframe>
            </div>
{% elif module.preview %}
            <figure class="module-trailer-preview">
                <div class="module-trailer-preview-label">Preview</div>
                <div class="module-trailer-preview-frame">
                    <img src="{{ module.preview | webp }}" alt="{{ module.previewAlt or (module.name + ' preview') }}" loading="lazy" decoding="async">
                </div>
{% if module.previewCaption %}
                <figcaption class="module-trailer-preview-caption">{{ module.previewCaption }}</figcaption>
{% endif %}
            </figure>
{% else %}
            <div class="module-trailer-placeholder">
                <span>Trailer coming soon</span>
            </div>
{% endif %}
        </div>

        <div class="module-detail-body ionrift-window">
            <p class="module-detail-lead">{{ module.description }}</p>

{% if module.detailBody and module.detailBody.length %}
            <div class="module-detail-copy">
{% for para in module.detailBody %}
                <p>{{ para }}</p>
{% endfor %}
            </div>
{% endif %}

{% if module.detailSections and module.detailSections.length %}
{% for sec in module.detailSections %}
            <div class="module-detail-copy module-detail-section">
                <h2 class="module-detail-section-heading">{{ sec.heading }}</h2>
                <ul class="module-detail-list">
{% for it in sec.items %}
{% set itMod = it.moduleId | moduleById %}
                    <li>{% if itMod %}<a href="/modules/{{ itMod.id }}/">{{ itMod.name }}</a> - {% endif %}{{ it.text }}</li>
{% endfor %}
                </ul>
            </div>
{% endfor %}
{% endif %}

{% if module.highlights and module.highlights.length %}
            <div class="module-highlights">
{% for h in module.highlights %}
                <span class="module-chip">{{ h }}</span>
{% endfor %}
            </div>
{% endif %}

            {# Link buttons: install route first, then GitHub, Wiki setup, and Patreon last (premium only). #}
            <div class="module-detail-actions">
{% if module.status == "retired" %}
{% elif module.install and module.install.method == "foundry" and module.links.foundryPackage %}
                <a href="{{ module.links.foundryPackage }}" target="_blank" rel="noopener" class="btn btn-ghost module-detail-cta module-detail-cta--foundry" data-track-event="module_install" data-track-method="foundry_listing" data-track-access="public">
                    <img src="/img/fvtt-anvil.webp" alt="" class="fvtt-btn-icon" width="64" height="32">
                    Foundry Module
                </a>
{% elif module.install and module.install.method == "patreon-manifest" %}
                <a href="/module-shelf/" class="btn btn-primary module-detail-cta">
                    {{ module.install.label }}
                </a>
{% endif %}
{% if module.links.github %}
                <a href="{{ module.links.github }}" target="_blank" rel="noopener" class="btn btn-ghost module-detail-cta module-detail-cta--github">
                    <svg class="module-detail-icon-inline" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    GitHub
                </a>
{% endif %}
{% if module.links.wiki %}
                <a href="{{ module.links.wiki }}" target="_blank" rel="noopener" class="btn btn-ghost module-detail-cta module-detail-cta--wiki">
                    <svg class="module-detail-icon-inline" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 1.75A.75.75 0 0 1 .75 1h4.253c1.227 0 2.317.59 3 1.501A3.743 3.743 0 0 1 11.006 1h4.245a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-4.507a2.25 2.25 0 0 0-1.591.659l-.622.621a.75.75 0 0 1-1.06 0l-.622-.621A2.25 2.25 0 0 0 5.258 13H.75a.75.75 0 0 1-.75-.75Zm7.251 10.324.004-5.073-.002-2.253A2.25 2.25 0 0 0 5.003 2.5H1.5v9h3.757a3.75 3.75 0 0 1 1.994.574ZM8.755 4.75l-.004 7.322a3.752 3.752 0 0 1 1.992-.572H14.5v-9h-3.495a2.25 2.25 0 0 0-2.25 2.25Z"/></svg>
                    Wiki setup
                </a>
{% endif %}
{% if module.install and module.install.method == "patreon-manifest" and module.links.patreon %}
                <a href="{{ module.links.patreon }}" target="_blank" rel="noopener" class="btn btn-patreon module-detail-cta">
                    Patreon
                </a>
{% endif %}
            </div>

{% if module.status == "retired" %}
{% elif module.install and module.install.method == "patreon-manifest" %}
            <p class="module-install-note">Subscribe on Patreon ({{ module.install.minTier or "Acolyte" }}+), then open the <a href="/module-shelf/">Modules</a> page, Connect Patreon, and copy the personal Foundry install link. Paste it into Foundry Add-on Modules. Not listed in the public Foundry browser.</p>
{% elif module.install and module.links.github %}
{% if module.install.method == "foundry" and module.links.foundryPackage %}
            <p class="module-install-note">Install from the <a href="{{ module.links.foundryPackage }}" target="_blank" rel="noopener">Foundry package page</a>, or grab the manifest from <a href="{{ module.links.github }}/releases/latest" target="_blank" rel="noopener" data-track-event="module_install" data-track-method="github" data-track-access="public">GitHub</a>.</p>
{% else %}
            <p class="module-install-note">Grab the manifest from <a href="{{ module.links.github }}/releases/latest" target="_blank" rel="noopener" data-track-event="module_install" data-track-method="github" data-track-access="public">GitHub</a> and paste it into Foundry Add-on Modules.</p>
{% endif %}
{% endif %}
        </div>

{% if module.related and module.related.length %}
        <section class="module-related-section" aria-label="Related Modules">
            <h2 class="module-related-heading">Works with</h2>
            <div class="module-related-grid">
{% for relId in module.related %}
{% set rel = relId | moduleById %}
{% if rel %}
                <a href="/modules/{{ rel.id }}/" class="module-related-card ionrift-window">
                    <img src="{{ rel.icon | webp }}" alt="" class="module-related-icon" width="40" height="40" loading="lazy" decoding="async">
                    <div class="module-related-info">
                        <span class="module-related-name">{{ rel.name }}</span>
                        <span class="module-related-tagline">{{ rel.tagline }}</span>
                    </div>
                </a>
{% endif %}
{% endfor %}
            </div>
        </section>
{% endif %}

        <p class="page-back">
            <a href="/#modules">&larr; All modules</a>
        </p>
    </div>
</main>

{% include "landing/footer.njk" %}
